# IncuBrix Video Editing Engine Environment Configuration
APP_NAME="IncuBrix Video Editing Engine"
APP_VERSION="1.0.0"
APP_ENV="production"
PORT=8000
HOST="0.0.0.0"

# Time Policy: SOURCE_TIME or TIMELINE_TIME
TIME_POLICY="SOURCE_TIME"

# Speech-to-Text Provider: mock or faster-whisper
STT_PROVIDER="mock"
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="float32"

# Security & Webhook Callbacks
WEBHOOK_SECRET="incubrix-secret-test-key-2026"
CORS_ORIGINS="*"

# Storage Backend: local or s3
STORAGE_BACKEND="local"
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="incubrix-renders"

# File Constraints
MAX_UPLOAD_SIZE_BYTES=524288000
