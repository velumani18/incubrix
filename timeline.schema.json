{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncuBrixVideoTimeline",
  "description": "Content-anchored, deterministic, non-destructive video timeline specification.",
  "type": "object",
  "required": [
    "schema_version",
    "timeline_id",
    "project_id",
    "source_media",
    "time_policy",
    "segments",
    "overlays",
    "audio_tracks",
    "duration_s",
    "timeline_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "timeline_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "time_policy": {
      "type": "string",
      "enum": ["SOURCE_TIME", "TIMELINE_TIME"],
      "default": "SOURCE_TIME",
      "description": "Policy governing how time references are resolved: SOURCE_TIME resolves against original raw media timestamps; TIMELINE_TIME resolves against projected sequence."
    },
    "source_media": {
      "type": "object",
      "required": ["filename", "sha256", "duration_s", "width", "height", "fps", "has_audio"],
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 0},
        "width": {"type": "integer"},
        "height": {"type": "integer"},
        "fps": {"type": "number"},
        "has_audio": {"type": "boolean"},
        "sample_rate": {"type": "integer"}
      }
    },
    "duration_s": {
      "type": "number",
      "minimum": 0,
      "description": "Total computed duration of the timeline in seconds"
    },
    "timeline_hash": {
      "type": "string",
      "description": "Deterministic SHA-256 hash of the timeline structure"
    },
    "segments": {
      "type": "array",
      "description": "Ordered sequence of video playback segments referencing original source spans",
      "items": {
        "type": "object",
        "required": ["segment_id", "source_start", "source_end", "speed"],
        "properties": {
          "segment_id": {"type": "string"},
          "source_start": {"type": "number", "minimum": 0},
          "source_end": {"type": "number", "minimum": 0},
          "speed": {"type": "number", "minimum": 0.1, "maximum": 16.0, "default": 1.0},
          "is_muted": {"type": "boolean", "default": false},
          "volume": {"type": "number", "minimum": 0.0, "maximum": 5.0, "default": 1.0},
          "speaker": {"type": ["string", "null"]}
        }
      }
    },
    "overlays": {
      "type": "array",
      "description": "Visual overlays (captions, lower-thirds) anchored to transcript words or content",
      "items": {
        "type": "object",
        "required": ["overlay_id", "type", "anchor", "content"],
        "properties": {
          "overlay_id": {"type": "string"},
          "type": {"type": "string", "enum": ["caption", "text_overlay"]},
          "content": {"type": "string"},
          "color": {"type": "string", "default": "#FFFFFF"},
          "font_size": {"type": "integer", "default": 36},
          "position": {"type": "string", "enum": ["bottom", "top", "center"], "default": "bottom"},
          "anchor": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["word_range", "phrase_match", "source_range"]
              },
              "start_word_id": {"type": ["string", "null"]},
              "end_word_id": {"type": ["string", "null"]},
              "phrase": {"type": ["string", "null"]},
              "fallback_source_start": {"type": ["number", "null"]},
              "fallback_source_end": {"type": ["number", "null"]}
            }
          }
        }
      }
    },
    "audio_effects": {
      "type": "array",
      "description": "Audio modifications anchored to content (bleeps, mutes)",
      "items": {
        "type": "object",
        "required": ["effect_id", "type", "anchor"],
        "properties": {
          "effect_id": {"type": "string"},
          "type": {"type": "string", "enum": ["bleep", "mute"]},
          "bleep_frequency": {"type": "integer", "default": 1000},
          "anchor": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"type": "string", "enum": ["word_range", "source_range"]},
              "start_word_id": {"type": ["string", "null"]},
              "end_word_id": {"type": ["string", "null"]},
              "source_start": {"type": ["number", "null"]},
              "source_end": {"type": ["number", "null"]}
            }
          }
        }
      }
    },
    "audio_tracks": {
      "type": "array",
      "description": "Additional audio tracks (background music, sound effects)",
      "items": {
        "type": "object",
        "required": ["track_id", "type", "file_path", "volume"],
        "properties": {
          "track_id": {"type": "string"},
          "type": {"type": "string", "enum": ["background_music", "sfx"]},
          "file_path": {"type": "string"},
          "volume": {"type": "number", "minimum": 0.0, "maximum": 2.0, "default": 0.15},
          "ducking": {
            "type": "object",
            "required": ["enabled"],
            "properties": {
              "enabled": {"type": "boolean", "default": true},
              "ducked_volume": {"type": "number", "default": 0.04},
              "attack_ms": {"type": "integer", "default": 150},
              "release_ms": {"type": "integer", "default": 400}
            }
          }
        }
      }
    }
  }
}
